rules_version = '2';
// Reglas de seguridad de Ecologia.
// Solo los correos de la lista pueden leer y modificar el inventario.
// Cambia TU_CORREO@gmail.com por tu correo de Google (puedes agregar más separados por coma).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['TU_CORREO@gmail.com'];
    }
    match /hilos/{id} {
      allow read, write: if autorizado();
    }
    match /movimientos/{id} {
      allow read, write: if autorizado();
    }
  }
}
